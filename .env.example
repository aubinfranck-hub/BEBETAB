# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Sécurité du serveur (voir server.ts). Tout est optionnel sauf ADMIN_TOKEN
# si tu veux utiliser la console publicitaire.
# ---------------------------------------------------------------------------

# ADMIN_TOKEN: jeton long et aléatoire (16 caractères minimum) exigé pour diffuser ou arrêter
# une publicité. S'il est absent, la console publicitaire est désactivée (réponse 503).
# Générer un jeton : openssl rand -hex 32
ADMIN_TOKEN=""

# AD_ALLOWED_HOSTS: noms de domaine autorisés pour les médias publicitaires, séparés par des
# virgules ("cdn.exemple.com, *.images.exemple.org"). Vide = tout domaine public en https.
AD_ALLOWED_HOSTS=""

# AD_GRACE_SECONDS: marge (en secondes) ajoutée à la durée d'une annonce avant son arrêt automatique.
# AD_GRACE_SECONDS=10

# ALLOWED_ORIGINS: origines de navigateur autorisées en plus du site lui-même pour le WebSocket
# /live ("https://localhost" pour une app Capacitor, par exemple), séparées par des virgules.
ALLOWED_ORIGINS=""

# TRUST_PROXY_HOPS: nombre de proxys de confiance devant le serveur (1 sur Render, Cloud Run…).
# À 0 (défaut), l'en-tête X-Forwarded-For est ignoré, donc les limites par IP ne sont pas contournables.
# TRUST_PROXY_HOPS=0

# PORT: port d'écoute (3000 par défaut). Les hébergeurs qui imposent un port le définissent eux-mêmes.
# PORT=3000

# Limites de la voix en direct (Gemini Live)
# LIVE_MAX_SECONDS=600
# LIVE_MAX_PER_IP=2
# LIVE_MAX_TOTAL=10

# Plafond global de requêtes IA par minute (protège la facture Gemini)
# GEMINI_GLOBAL_RPM=120

# Modèles Gemini : les versions « preview » peuvent être retirées, change-les ici sans toucher au code.
# GEMINI_TEXT_MODEL=gemini-3.6-flash
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

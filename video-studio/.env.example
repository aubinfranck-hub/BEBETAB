# ElevenLabs (npm run voice)
ELEVENLABS_API_KEY=
# Identifiant de la voix choisie dans la bibliothèque ElevenLabs (ou d'un clone vocal autorisé)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Rendu (optionnel)
# Chemin d'un Chromium/Chrome si celui de Puppeteer n'est pas installé
PUPPETEER_EXECUTABLE_PATH=
# Nombre de workers de rendu en parallèle (1 par défaut)
RENDER_WORKERS=1
# Télémétrie PostHog de Revideo (désactivée par défaut dans scripts/render.ts)
DISABLE_TELEMETRY=true
# Durée max d'un rendu avant interruption (minutes)
RENDER_TIMEOUT_MIN=45
